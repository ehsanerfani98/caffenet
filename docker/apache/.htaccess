# ============================================================================
# Caffenet — Apache/LiteSpeed .htaccess for Shared Hosting
# ============================================================================
# Place this file in public_html/ to enable:
# 1. SPA routing (all paths → index.html)
# 2. API proxying to Node.js (Passenger/LSAPI)
# 3. Security headers
# 4. Static file caching
# 5. Gzip compression
# ============================================================================

# Enable rewrite engine
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Security: block dotfiles
  RewriteRule ^\.(?!well-known) - [F,L]

  # API requests → Node.js (Passenger LSAPI)
  # Assumes Node.js app is at /home/USER/caffenet/api/dist/main.js
  RewriteRule ^api/v1/(.*)$ http://127.0.0.1:3001/api/v1/$1 [P,L]

  # Health check
  RewriteRule ^health$ http://127.0.0.1:3001/health [P,L]

  # SPA fallback — all non-file paths → index.html
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/health
  RewriteCond %{REQUEST_URI} !^/_next/
  RewriteCond %{REQUEST_URI} !^/icons/
  RewriteCond %{REQUEST_URI} !^/manifest.webmanifest
  RewriteCond %{REQUEST_URI} !^/sw.js
  RewriteCond %{REQUEST_URI} !^/static/
  RewriteCond %{REQUEST_URI} !\.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|eot|map)$
  RewriteRule ^ index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  # CSP — adjust as needed
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.pusher.com wss://*.pusher.com; frame-ancestors 'none'"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Disable directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "(^\.|\.(env|sql|md|sh|bak)$)">
  Require all denied
</FilesMatch>

# Allow service worker at root
<FilesMatch "^sw\.js$">
  Header set Cache-Control "no-cache, must-revalidate"
  Header set Service-Worker-Allowed "/"
</FilesMatch>
