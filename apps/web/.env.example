# ==================== Caffenet Web (Next.js) ====================
# Copy to .env.local and fill in the values.

# Deployment profile: 'shared' or 'vps'
DEPLOYMENT_PROFILE=shared

# API URL (backend NestJS)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Pusher client (these are PUBLIC, safe to expose)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Pusher channel auth endpoint (optional override, defaults to /api/v1/broadcasting/auth)
NEXT_PUBLIC_PUSHER_AUTH_ENDPOINT=http://localhost:3001/api/v1/broadcasting/auth

# VAPID public key (for Web Push subscriptions)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# App metadata (PWA)
NEXT_PUBLIC_APP_NAME=کافی‌نت
NEXT_PUBLIC_APP_NAME_EN=Caffenet
