# ============================================================
# Caffenet API — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ==================== APP ====================
NODE_ENV=development
PORT=3001
APP_NAME=Caffenet
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Deployment profile: 'shared' or 'vps'
# - shared: file cache, db queue, local storage, cron worker
# - vps: redis cache, bullmq queue, s3 storage, pm2 worker
DEPLOYMENT_PROFILE=shared

# ==================== DATABASE ====================
# MySQL 8 connection (primary)
DATABASE_URL=mysql://root:rootpassword@localhost:3306/caffenet
# Optional: PostgreSQL for VPS advanced deployment
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caffenet

# Pooling (VPS only)
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=30

# ==================== CACHE ====================
# Driver: 'file' (default, shared hosting) or 'redis' (VPS)
CACHE_DRIVER=file
# Redis URL (only used when CACHE_DRIVER=redis)
REDIS_URL=redis://localhost:6379/0

# ==================== QUEUE ====================
# Driver: 'database' (default, shared hosting) or 'redis' (VPS, BullMQ)
QUEUE_DRIVER=database
# Same Redis URL for BullMQ (only used when QUEUE_DRIVER=redis)
QUEUE_REDIS_URL=redis://localhost:6379/1

# ==================== STORAGE ====================
# Driver: 'local' (default, shared hosting) or 's3' (VPS)
STORAGE_DRIVER=local
# Local storage paths
STORAGE_LOCAL_PUBLIC_PATH=./storage/app/public
STORAGE_LOCAL_PRIVATE_PATH=./storage/app/private
# S3 config (only when STORAGE_DRIVER=s3)
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=caffenet
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_PUBLIC_BASE_URL=http://localhost:9000/caffenet

# ==================== AUTH ====================
# JWT secrets — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=replace-with-different-openssl-rand-base64-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ==================== PUSHER (Real-Time) ====================
# Get these from https://dashboard.pusher.com/
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1
PUSHER_CHANNEL_ENCRYPTION_MASTER_KEY=
# Frontend uses these (must be public, prefixed with NEXT_PUBLIC_ when in web)
PUSHER_CLIENT_KEY=
PUSHER_CLIENT_CLUSTER=mt1

# ==================== ZARINPAL (Payment Gateway) ====================
# Get Merchant ID from https://next.zarinpal.com/
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/callback

# ==================== iPanel (SMS Provider) ====================
# Get API key from https://ippanel.com/
IPANEL_API_KEY=
IPANEL_SENDER=
# Pattern-based OTP — fill pattern IDs from iPanel dashboard
IPANEL_OTP_PATTERN_CODE=
IPANEL_OTP_PARAM_NAME=code

# ==================== WEB PUSH (VAPID) ====================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ==================== MAIL (SMTP) ====================
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@caffenet.local

# ==================== SECURITY ====================
CORS_ORIGINS=http://localhost:3000
COOKIE_SECRET=replace-with-openssl-rand-base64-64
BCRYPT_COST=12

# ==================== LOGGING ====================
LOG_LEVEL=debug
LOG_FILE_PATH=./storage/logs/api.log
# 'true' to enable pretty logging (dev), 'false' for JSON logs (prod)
LOG_PRETTY=true

# ==================== WORKER (Cron) ====================
WORKER_MAX_JOBS=50
WORKER_TIMEOUT_SECONDS=55
WORKER_QUEUE_NAME=caffenet-jobs

# ==================== FILE UPLOAD ====================
FILE_UPLOAD_MAX_SIZE=10485760
FILE_UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
